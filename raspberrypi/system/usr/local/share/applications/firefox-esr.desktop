[Desktop Entry]
Type=Application
Name=İnternet Tarayıcısı
Comment=ARMv6 için temel web; yeni Pi modelleri için Firefox
Exec=/usr/local/bin/oguzdows-browser %u
Icon=web-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
