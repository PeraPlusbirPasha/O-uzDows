#!/bin/sh
set -eu
[ "$#" -eq 0 ] || { echo 'Kurucu ek komut kabul etmez.' >&2; exit 2; }
[ "$(id -u)" -eq 0 ] || { echo 'Kurucu için yönetici yetkisi gerekli.' >&2; exit 1; }
case " $(cat /proc/cmdline) " in
    *' boot=live '*) ;;
    *) echo 'Kurucu yalnızca OğuzDows canlı ortamında çalışır.' >&2; exit 1 ;;
esac
# Birden fazla kurucu aynı anda disklerde işlem yapmasın.
exec 9>/run/lock/oguzdows-installer.lock
flock -n 9 || { echo 'OğuzDows kurucusu zaten açık.' >&2; exit 1; }
umask 077
install -d -m 0755 /var/log/oguzdows
LOG=$(mktemp /var/log/oguzdows/installer.XXXXXX.log)
ln -sfn "${LOG##*/}" /var/log/oguzdows/installer.log
export LANG=tr_TR.UTF-8 LANGUAGE=tr LC_MESSAGES=tr_TR.UTF-8
export QT_QPA_PLATFORMTHEME=gtk3
# Standart /etc/calamares/settings.conf otomatik okunur. --config'e dosya
# vermek geçersizdi; dizinle override etmek de varsayılan kaynak aramasını daraltır.
# Gözetmen, yalnızca son Calamares işinin ürettiği yeni başarı kaydını kabul eder.
exec /usr/bin/python3 -I /usr/lib/oguzdows/run-installer.py --log "$LOG"
